    <select id="getCmstSolublegasinoilList" resultMap="BaseResultMap">
        SELECT ACQUISITIONTIME, ISDETECT, H2, CH4, C2H4, C2H6, C2H2, TOTALHYDROCARBON, VOLTAGEGRADE, devicecode,OBJ_ID
        FROM (SELECT sorted_data.*,
                     CASE WHEN @devicecode = devicecode THEN @row_number := @row_number + 1 ELSE @row_number := 1 END AS row_num,
                     @devicecode := devicecode
              FROM (SELECT cs.ACQUISITIONTIME, cs.ISDETECT, cs.H2, cs.CH4, cs.C2H4, cs.C2H6, cs.C2H2, cs.TOTALHYDROCARBON, cp.VOLTAGEGRADE, cp.devicecode,cs.OBJ_ID
                  FROM cmst_solublegasinoil cs INNER JOIN cmst_transfdevice ct ON cs.DEVICECODE = ct.DEVICECODE
                  INNER JOIN cmst_physicsdevice cp ON cp.OBJ_ID = ct.PHYSICDEVICE WHERE cs.ACQUISITIONTIME !="0000-00-00 00:00:00" and cs.ACQUISITIONTIME is not null
                  ORDER BY cp.devicecode, cs.ACQUISITIONTIME DESC) sorted_data
                  CROSS JOIN (SELECT @row_number := 0, @devicecode := '') vars) ranked_data
        WHERE 150>=row_num
    </select>


